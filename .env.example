# ── Platform vars (required by hive-ops) ──────────────────────────────────────

# App identifier; controls container name prefix
APP_NAME=baseball

# Public domain for this app (e.g. baseball.hive.local)
APP_DOMAIN=baseball.hive.local

# Used by Docker Compose to prefix container and network names
COMPOSE_PROJECT_NAME=baseball

# Storage mode for persistent data (local or s3)
STORAGE_MODE=local

# Path under which ./data/ volumes are stored
STORAGE_PATH=/home/deploy/baseball

# Timezone for all services
TZ=America/Vancouver

# ── App vars ───────────────────────────────────────────────────────────────────

# ESPN private API session cookie (from browser devtools)
ESPN_S2=changeme

# ESPN SWID cookie (UUID format, including braces)
ESPN_SWID={changeme}

# Your ESPN fantasy league ID
LEAGUE_ID=changeme

# Your ESPN fantasy team ID within the league
TEAM_ID=changeme

# API key for all /api/* requests — pass as X-API-Key header
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme
